# Copy this file to .env and replace the secret. .env is gitignored; NEVER commit real secret.
SHARED_SECRET=REPLACE-WITH-GENERATED-STRING!!!
SANDBOX_IMAGE=cloudproject-sandbox:dev
LOCAL_MEMORY_BUDGET_MB=512
# Set true only after EKS namespace, policy enforcement, and image are verified.
EKS_ENABLED=false
EKS_CONTEXT=cloudproject-sandbox-lab
EKS_IMAGE=REPLACE-WITH-ECR-URI-AT-SHA256-DIGEST
EKS_MAX_INFLIGHT=3
# Optional Learner Lab fallback: local gateway scales sandbox-workers from 1 to 2
# using your AWS CLI credentials when a sandbox Pod lacks node resources.
# This is not Kubernetes Cluster Autoscaler; the gateway must stay running.
EKS_NODE_SCALING_ENABLED=false
EKS_CLUSTER=cloudproject-sandbox-lab
EKS_NODEGROUP=sandbox-workers
EKS_NODE_IDLE_SECONDS=300
AWS_REGION=us-east-1
ENDPOINT_URL=http://127.0.0.1:5000/execute
GATEWAY_URL=http://127.0.0.1:8000/submit
NOTIFY_URL=http://127.0.0.1:9000/notify
