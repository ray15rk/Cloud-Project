# Copy this file to .env and replace the secret. .env is gitignored; NEVER commit real secrets.
SHARED_SECRET=REPLACE-WITH-GENERATED-STRING!!!
SANDBOX_IMAGE=cloudproject-sandbox:dev
LOCAL_MEMORY_BUDGET_MB=512

# Enable only after the EKS namespace, network policy, and image are ready.
EKS_ENABLED=false
EKS_CONTEXT=cloudproject-sandbox-sydney
EKS_IMAGE=REPLACE-WITH-ECR-URI-AT-SHA256-DIGEST
EKS_MAX_INFLIGHT=3
AWS_REGION=ap-southeast-2
AWS_PROFILE=cloudproject-sydney
KUBECONFIG=/Users/rance/.kube/config-cloudproject-sydney

ENDPOINT_URL=http://127.0.0.1:5000/execute
GATEWAY_URL=http://127.0.0.1:8080/submit
NOTIFY_URL=http://127.0.0.1:9000/notify

# Execution mode: "hybrid" = local Docker first, EKS overflow (default); "cloud" = every dry run is an EKS Job.
EXECUTION_MODE=hybrid
# Concurrent EKS Jobs the gateway runs. Keep within the namespace quota (infra/k8s/sandbox-namespace.yaml).
EKS_WORKERS=2

# Behavioural threat detection with Falco (EKS runs only). Setup: docs/falco-setup.md
FALCO_ENABLED=false
FALCO_NAMESPACE=falco
FALCO_POD_SELECTOR=app.kubernetes.io/name=falco
FALCO_SETTLE_SECONDS=3
FALCO_WAIT_SECONDS=20
