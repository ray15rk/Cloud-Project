# Copy this file to .env and replace the secret. .env is gitignored; NEVER commit real secrets.
SHARED_SECRET=REPLACE-WITH-GENERATED-STRING!!!
# Every verified dry run uses EKS. Complete AWS access and update KUBECONFIG with your Windows username.
EKS_ENABLED=true
EKS_CONTEXT=cloudproject-sandbox-sydney
EKS_IMAGE=562358727339.dkr.ecr.ap-southeast-2.amazonaws.com/cloudproject-sandbox@sha256:a2a31397c0f6a17856138c71ad14300b1e592ccc46e3ee0f61d7167911c5bffa
EKS_MAX_INFLIGHT=3
AWS_REGION=ap-southeast-2
# Standard project AWS profile generated during Step 2 of EKS onboarding
AWS_PROFILE=cloudproject-sydney
# Replace <username> with your Windows username (e.g. run '$env:USERPROFILE' in PowerShell)
KUBECONFIG=C:\Users\<username>\.kube\config-cloudproject-sydney

ENDPOINT_URL=http://127.0.0.1:5000/execute
GATEWAY_URL=http://127.0.0.1:8000/submit
NOTIFY_URL=http://127.0.0.1:9000/notify

# Concurrent EKS Jobs the gateway runs. Keep within the namespace quota (infra/k8s/sandbox-namespace.yaml).
EKS_WORKERS=2

# Behavioural threat detection on EKS. Setup: docs/falco-setup.md
FALCO_ENABLED=true
FALCO_NAMESPACE=falco
FALCO_POD_SELECTOR=app.kubernetes.io/name=falco
FALCO_SETTLE_SECONDS=3
FALCO_WAIT_SECONDS=20
